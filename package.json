{
  "name": "corvex-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch backend/server.js",
    "migrate": "node backend/run_migrations.js",
    "seed:demo-customer": "node backend/scripts/seed_demo_customer_portal.js",
    "seed:saw-davao": "node backend/scripts/seed_davao_saw_collection.js",
    "seed:secondary-branches": "node backend/scripts/seed_secondary_branches.js",
    "seed:reset-passwords": "node backend/reset_passwords.js",
    "saw:csv": "node backend/scripts/run_saw_from_csv.js",
    "check:schema": "node scripts/check_schema.mjs",
    "check:credit": "node backend/scripts/verify_credit_consistency.js",
    "check:suppliers": "node scripts/check_suppliers.js",
    "check:territories": "node scripts/check_territories.js",
    "check:migrations": "node scripts/check_migrations.mjs",
    "lint": "eslint . --max-warnings 99999",
    "format:check": "prettier --check AGENTS.md CONTRIBUTING.md docs/PROJECT_SCOPE.md docs/ARCHITECTURE.md docs/MIGRATION_REVIEW.md docs/QUALITY_SYSTEM_AUDIT.md docs/QUALITY_SYSTEM_REPORT.md eslint.config.js scripts/check_migrations.mjs .github/workflows",
    "format": "prettier --write AGENTS.md CONTRIBUTING.md docs/PROJECT_SCOPE.md docs/ARCHITECTURE.md docs/MIGRATION_REVIEW.md docs/QUALITY_SYSTEM_AUDIT.md docs/QUALITY_SYSTEM_REPORT.md eslint.config.js scripts/check_migrations.mjs .github/workflows",
    "check:dupes": "jscpd src backend --config .jscpd.json",
    "quality": "npm run lint && npm run format:check && npm run check:migrations && npm test && npm run build",
    "test": "node --test backend/tests/*.test.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@jobuntux/psgc": "^0.2.1",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.42.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.26.2",
    "recharts": "2.15.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "jscpd": "^5.4.3",
    "postcss": "^8.5.28",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.8"
  }
}
