# Database
DATABASE_URL=postgresql://user:password@localhost:5432/corvex

# JWT / auth (set in your real .env)
JWT_SECRET=change-me

# Frontend URL used in activation links (no trailing slash)
FRONTEND_URL=http://localhost:5173

# OSRM driving directions (optional — defaults to public router.project-osrm.org)
# OSRM_BASE_URL=https://router.project-osrm.org

# Portal invitation expiry (hours) — email text matches this value
PORTAL_INVITE_TTL_HOURS=24

# Outgoing email (SMTP) — required for automatic customer activation emails
#
# --- Gmail (recommended for dev / small volume) ---
# 1. Google Account → Security → turn on 2-Step Verification
# 2. Security → App passwords → create one for "Mail" / "Other (Corvex)"
# 3. Use that 16-character password as SMTP_PASS (not your normal Gmail password)
# 4. SMTP_USER = your full @gmail.com address
# Limits: personal Gmail ~500/day; Google Workspace higher. "Send mail as" alias optional in SMTP_FROM.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="Corvex Accounts <you@gmail.com>"

# Optional footer / branding in activation emails
COMPANY_NAME=Corvex
SUPPORT_EMAIL=support@yourdomain.com
SUPPORT_PHONE=+63 900 000 0000
