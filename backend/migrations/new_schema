-- =====================================================================
-- CORVEX Database Schema — Migration Script
-- BH Marketing — Field Operations & Decision Support System
-- Target: PostgreSQL 13+, database name: corvex
--
-- Generated from CORVEX_Database_Schema_Revised.docx (Revision 2:
-- offline sync, field activity reports, invoice numbering, product
-- category normalization, uniqueness constraints).
--
-- HOW TO RUN
-- ----------
-- 1) Create the database (run once, outside any transaction, e.g. as
--    a superuser or a role with CREATEDB):
--
--      createdb corvex
--
--    or from psql:
--
--      CREATE DATABASE corvex;
--
-- 2) Run this script against that database:
--
--      psql -U your_user -d corvex -f corvex_schema.sql
--
-- This script creates tables in dependency order (parents before
-- children) so foreign keys resolve on first pass. Run it against an
-- EMPTY corvex database.
-- =====================================================================

BEGIN;

-- ---------------------------------------------------------------------
-- Helper: generic trigger to auto-maintain updated_at columns
-- (Postgres has no built-in "ON UPDATE CURRENT_TIMESTAMP" like MySQL)
-- ---------------------------------------------------------------------
CREATE OR REPLACE FUNCTION set_updated_at()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = CURRENT_TIMESTAMP;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;


-- =====================================================================
-- ACCESS & IDENTITY
-- =====================================================================

CREATE TABLE roles (
    role_id      SERIAL PRIMARY KEY,
    role_name    VARCHAR(50) NOT NULL,
    slug         VARCHAR(50) NOT NULL UNIQUE,
    created_at   TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at   TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TRIGGER trg_roles_updated_at
    BEFORE UPDATE ON roles
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TABLE permissions (
    permission_id SERIAL PRIMARY KEY,
    label         VARCHAR(100) NOT NULL,
    description   TEXT NOT NULL,
    created_at    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE role_permissions (
    role_id       INTEGER NOT NULL REFERENCES roles(role_id) ON DELETE CASCADE,
    permission_id INTEGER NOT NULL REFERENCES permissions(permission_id) ON DELETE CASCADE,
    granted       BOOLEAN NOT NULL DEFAULT TRUE,
    created_at    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (role_id, permission_id)
);
CREATE TRIGGER trg_role_permissions_updated_at
    BEFORE UPDATE ON role_permissions
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();


-- =====================================================================
-- BRANCHES & TERRITORIES
-- =====================================================================

CREATE TABLE branches (
    branch_id    SERIAL PRIMARY KEY,
    branch_name  VARCHAR(50) NOT NULL,
    address      VARCHAR(150) NOT NULL,          -- includes city
    latitude     DECIMAL(10,7) NOT NULL,
    longitude    DECIMAL(10,7) NOT NULL,
    contact_no   VARCHAR(20) NOT NULL,
    email        VARCHAR(100) NOT NULL,
    status       VARCHAR(20) NOT NULL DEFAULT 'Active'
                 CHECK (status IN ('Active', 'Inactive')),
    created_at   TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at   TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TRIGGER trg_branches_updated_at
    BEFORE UPDATE ON branches
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

-- depends on branches, roles
CREATE TABLE users (
    user_id      SERIAL PRIMARY KEY,
    branch_id    INTEGER NOT NULL REFERENCES branches(branch_id),
    first_name   VARCHAR(50) NOT NULL,
    last_name    VARCHAR(50) NOT NULL,
    role_id      INTEGER NOT NULL REFERENCES roles(role_id),
    email        VARCHAR(150) NOT NULL UNIQUE,
    password     VARCHAR(255) NOT NULL,
    status       VARCHAR(20) NOT NULL DEFAULT 'Active'
                 CHECK (status IN ('Active', 'Inactive')),
    created_at   TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at   TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TRIGGER trg_users_updated_at
    BEFORE UPDATE ON users
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

-- depends on branches, users
CREATE TABLE territories (
    territory_id   SERIAL PRIMARY KEY,
    territory_name VARCHAR(100) NOT NULL,
    branch_id      INTEGER NOT NULL REFERENCES branches(branch_id),
    assigned_user  INTEGER REFERENCES users(user_id),
    coverage_area  TEXT NOT NULL
);


-- =====================================================================
-- LOOKUPS: payment methods, product categories, products, suppliers
-- =====================================================================

CREATE TABLE payment_methods (
    payment_method_id SERIAL PRIMARY KEY,
    method_name       VARCHAR(50) NOT NULL,   -- Cash, Check, Bank Transfer, GCash, Maya, Credit
    status            VARCHAR(20) NOT NULL DEFAULT 'Active'
                       CHECK (status IN ('Active', 'Inactive'))
);

CREATE TABLE product_categories (
    category_id   SERIAL PRIMARY KEY,
    category_name VARCHAR(50) NOT NULL UNIQUE,
    status        VARCHAR(20) NOT NULL DEFAULT 'Active'
                  CHECK (status IN ('Active', 'Inactive')),
    created_at    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- depends on product_categories
CREATE TABLE products (
    product_id   SERIAL PRIMARY KEY,
    product_name VARCHAR(100) NOT NULL,
    category_id  INTEGER NOT NULL REFERENCES product_categories(category_id),
    unit_price   DECIMAL(10,2) NOT NULL,
    status       VARCHAR(20) NOT NULL DEFAULT 'Active'
                 CHECK (status IN ('Active', 'Inactive'))
);

CREATE TABLE suppliers (
    suppliers_id  SERIAL PRIMARY KEY,
    supplier_name VARCHAR(150) NOT NULL,
    contact       VARCHAR(120) NOT NULL,
    email         VARCHAR(120) NOT NULL,
    address       TEXT NOT NULL,
    status        VARCHAR(20) NOT NULL DEFAULT 'Active'
                  CHECK (status IN ('Active', 'Inactive')),
    created_at    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TRIGGER trg_suppliers_updated_at
    BEFORE UPDATE ON suppliers
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();


-- =====================================================================
-- CUSTOMERS & CREDIT (depends on users, branches)
-- =====================================================================

CREATE TABLE customers (
    customer_id          SERIAL PRIMARY KEY,
    user_id              INTEGER REFERENCES users(user_id),
    branch_id            INTEGER NOT NULL REFERENCES branches(branch_id),
    first_name           VARCHAR(20) NOT NULL,
    last_name            VARCHAR(20) NOT NULL,
    address              VARCHAR(150) NOT NULL,
    latitude             DECIMAL(10,7) NOT NULL,
    longitude            DECIMAL(10,7) NOT NULL,
    contact_phone        VARCHAR(30) NOT NULL,
    contact_person_fname VARCHAR(100) NOT NULL,
    contact_person_lname VARCHAR(100) NOT NULL,
    contact_person_phone VARCHAR(30) NOT NULL,
    status               VARCHAR(20) NOT NULL DEFAULT 'Active'
                         CHECK (status IN ('Active', 'Inactive')),
    created_at           TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at           TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TRIGGER trg_customers_updated_at
    BEFORE UPDATE ON customers
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

-- one row per customer: current-standing snapshot, not a history
CREATE TABLE customer_activity (
    activity_id          SERIAL PRIMARY KEY,
    customer_id          INTEGER NOT NULL UNIQUE REFERENCES customers(customer_id) ON DELETE CASCADE,
    outstanding_balance  DECIMAL(12,2) NOT NULL DEFAULT 0,
    purchase_volume      DECIMAL(12,2) NOT NULL DEFAULT 0,
    last_collection_date DATE,
    last_sales_visit     DATE,
    updated_at           TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TRIGGER trg_customer_activity_updated_at
    BEFORE UPDATE ON customer_activity
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

-- one credit profile per customer
CREATE TABLE customer_credit_info (
    credit_info_id    SERIAL PRIMARY KEY,
    customer_id       INTEGER NOT NULL UNIQUE REFERENCES customers(customer_id) ON DELETE CASCADE,
    credit_limit      DECIMAL(12,2) NOT NULL DEFAULT 0,
    monthly_income    DECIMAL(12,2),
    employment_status VARCHAR(50),
    credit_score      INTEGER,
    approved_by       INTEGER REFERENCES users(user_id),
    approved_date     DATE,
    created_at        TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at        TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TRIGGER trg_customer_credit_info_updated_at
    BEFORE UPDATE ON customer_credit_info
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();


-- =====================================================================
-- INVENTORY (depends on branches, products, suppliers, users)
-- =====================================================================

CREATE TABLE branch_inventory (
    inventory_id     SERIAL PRIMARY KEY,
    branch_id        INTEGER NOT NULL REFERENCES branches(branch_id),
    product_id       INTEGER NOT NULL REFERENCES products(product_id),
    available_stock  INTEGER NOT NULL DEFAULT 0,
    reorder_level    INTEGER NOT NULL DEFAULT 0,
    updated_at       TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (branch_id, product_id)      -- prevents duplicate stock rows for the same product/branch
);
CREATE TRIGGER trg_branch_inventory_updated_at
    BEFORE UPDATE ON branch_inventory
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TABLE restock_records (
    restock_id    SERIAL PRIMARY KEY,
    product_id    INTEGER NOT NULL REFERENCES products(product_id),
    branch_id     INTEGER NOT NULL REFERENCES branches(branch_id),
    delivery_ref  VARCHAR(100) NOT NULL,
    supplier_id   INTEGER NOT NULL REFERENCES suppliers(suppliers_id),
    quantity      INTEGER NOT NULL,
    received_date DATE NOT NULL
);

CREATE TABLE stock_movements (
    stock_movements_id SERIAL PRIMARY KEY,
    performed_by        INTEGER NOT NULL REFERENCES users(user_id),
    product_id           INTEGER NOT NULL REFERENCES products(product_id),
    quantity              INTEGER NOT NULL,   -- positive = stock in, negative = stock out
    type                  VARCHAR(50) NOT NULL
                          CHECK (type IN ('Sale Deduction', 'Restock', 'Transfer In',
                                           'Transfer Out', 'Stock Count Adjustment',
                                           'Damage Write-Off')),
    movement_ref          VARCHAR(100) NOT NULL,
    movement_date         DATE NOT NULL,
    created_at            TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE transfers (
    transfer_id           SERIAL PRIMARY KEY,
    transfer_ref          VARCHAR(100) NOT NULL,
    product_id            INTEGER NOT NULL REFERENCES products(product_id),
    quantity               INTEGER NOT NULL,
    source_branch_id      INTEGER NOT NULL REFERENCES branches(branch_id),
    destination_branch_id INTEGER NOT NULL REFERENCES branches(branch_id),
    status                 VARCHAR(30) NOT NULL DEFAULT 'Pending Approval'
                           CHECK (status IN ('Pending Approval', 'Submitted', 'Approved',
                                              'Completed', 'Rejected')),
    submitted_by           INTEGER NOT NULL REFERENCES users(user_id),
    approved_by            INTEGER REFERENCES users(user_id),
    approval_info          TEXT,
    submitted_date         DATE NOT NULL,
    completed_date         DATE,
    created_at             TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at             TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CHECK (source_branch_id <> destination_branch_id)
);
CREATE TRIGGER trg_transfers_updated_at
    BEFORE UPDATE ON transfers
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();


-- =====================================================================
-- SALES (depends on customers, users, branches, payment_methods, products)
-- =====================================================================

CREATE TABLE sales_invoices (
    sales_invoices_id SERIAL PRIMARY KEY,
    invoice_number      VARCHAR(30) NOT NULL UNIQUE,   -- e.g. INV-2026-000001
    customer_id           INTEGER REFERENCES customers(customer_id),
    sales_agent_id         INTEGER REFERENCES users(user_id),
    branch_id               INTEGER NOT NULL REFERENCES branches(branch_id),
    total_amount             DECIMAL(12,2) NOT NULL,
    payment_method_id         INTEGER NOT NULL REFERENCES payment_methods(payment_method_id),
    status                     VARCHAR(30) NOT NULL DEFAULT 'Draft'
                               CHECK (status IN ('Draft', 'Confirmed', 'Pending Review', 'Cancelled')),
    invoices_date               DATE NOT NULL,
    notes                        TEXT,
    created_at                    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at                     TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TRIGGER trg_sales_invoices_updated_at
    BEFORE UPDATE ON sales_invoices
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TABLE sales_invoice_items (
    sales_invoices_items_id SERIAL PRIMARY KEY,
    invoices_id               INTEGER NOT NULL REFERENCES sales_invoices(sales_invoices_id) ON DELETE CASCADE,
    product_id                 INTEGER NOT NULL REFERENCES products(product_id),
    quantity                    INTEGER NOT NULL,
    unit_price                   DECIMAL(12,2) NOT NULL,
    line_total                    DECIMAL(12,2) NOT NULL,
    created_at                     TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);


-- =====================================================================
-- COLLECTIONS & PAYMENTS
-- =====================================================================

CREATE TABLE collection_payment (
    collectionpayment_id SERIAL PRIMARY KEY,
    receipt_number         VARCHAR(50) NOT NULL UNIQUE,
    customer_id             INTEGER REFERENCES customers(customer_id),
    collector_id             INTEGER NOT NULL REFERENCES users(user_id),
    branch_id                 INTEGER NOT NULL REFERENCES branches(branch_id),
    amount                     DECIMAL(12,2) NOT NULL,
    payment_method_id         INTEGER NOT NULL REFERENCES payment_methods(payment_method_id),
    payment_date               DATE NOT NULL,
    payment_time                TIME NOT NULL,
    status                       VARCHAR(20) NOT NULL DEFAULT 'Pending'
                                CHECK (status IN ('Pending', 'Completed', 'Cancelled')),
    notes                        TEXT,
    created_at                    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at                     TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TRIGGER trg_collection_payment_updated_at
    BEFORE UPDATE ON collection_payment
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

CREATE TABLE digital_receipts (
    receipts_id     SERIAL PRIMARY KEY,
    collection_id     INTEGER NOT NULL REFERENCES collection_payment(collectionpayment_id),
    receipt_number     VARCHAR(25) NOT NULL UNIQUE,
    receipt_date        TIMESTAMP NOT NULL,
    generated_by         INTEGER NOT NULL REFERENCES users(user_id)
);

-- depends on customers, sales_invoices, collection_payment
CREATE TABLE credit_history (
    credit_id          SERIAL PRIMARY KEY,
    customer_id          INTEGER NOT NULL REFERENCES customers(customer_id),
    sales_id              INTEGER REFERENCES sales_invoices(sales_invoices_id),
    collection_id          INTEGER REFERENCES collection_payment(collectionpayment_id),
    previous_balance        DECIMAL(10,2) NOT NULL,
    payment_amount            DECIMAL(10,2) NOT NULL,
    remaining_balance          DECIMAL(10,2) NOT NULL,
    payment_status               VARCHAR(20) NOT NULL
                                 CHECK (payment_status IN ('Paid', 'Partial', 'Overdue')),
    transaction_date              DATE NOT NULL
);


-- =====================================================================
-- FIELD OPERATIONS (depends on customers, users)
-- =====================================================================

CREATE TABLE field_visits (
    visit_id        SERIAL PRIMARY KEY,
    customer_id       INTEGER NOT NULL REFERENCES customers(customer_id),
    user_id             INTEGER NOT NULL REFERENCES users(user_id),
    visit_type           VARCHAR(20) NOT NULL CHECK (visit_type IN ('Collection', 'Sales')),
    scheduled_date         DATE NOT NULL,
    status                  VARCHAR(20) NOT NULL DEFAULT 'Pending'
                            CHECK (status IN ('Pending', 'Completed')),
    created_at               TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at                TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TRIGGER trg_field_visits_updated_at
    BEFORE UPDATE ON field_visits
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

-- depends on field_visits, users — FR-20
CREATE TABLE field_activity_reports (
    report_id       SERIAL PRIMARY KEY,
    visit_id          INTEGER NOT NULL REFERENCES field_visits(visit_id),
    user_id             INTEGER NOT NULL REFERENCES users(user_id),
    activity_type         VARCHAR(50) NOT NULL,   -- e.g. Collection, Sales Visit, Delivery, Site Check
    remarks                TEXT,
    photo                    VARCHAR(255),          -- path/URL to optional photo evidence
    sync_status               VARCHAR(20) NOT NULL DEFAULT 'Pending'
                              CHECK (sync_status IN ('Pending', 'Synced', 'Failed')),
    created_at                 TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

-- generic offline-transaction queue; depends only on users
CREATE TABLE offline_sync_queue (
    sync_queue_id    SERIAL PRIMARY KEY,
    user_id            INTEGER NOT NULL REFERENCES users(user_id),
    device_id            VARCHAR(100),
    table_name             VARCHAR(50) NOT NULL,   -- target table, e.g. 'collection_payment'
    record_reference         VARCHAR(100) NOT NULL,  -- local/offline-generated reference ID
    payload                    TEXT NOT NULL,          -- serialized (JSON) offline-recorded data
    sync_status                  VARCHAR(20) NOT NULL DEFAULT 'Pending'
                                 CHECK (sync_status IN ('Pending', 'Synced', 'Failed')),
    attempted_at                   TIMESTAMP,
    synced_at                        TIMESTAMP,
    created_at                         TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE saw_results (
    result_id     SERIAL PRIMARY KEY,
    customer_id     INTEGER NOT NULL REFERENCES customers(customer_id),
    engine_type       VARCHAR(20) NOT NULL CHECK (engine_type IN ('Collection', 'Sales')),
    score               DECIMAL(4,4) NOT NULL,
    ranking              INTEGER NOT NULL,
    generated_at          TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);


-- =====================================================================
-- SYSTEM & REPORTING (depends on branches, users)
-- =====================================================================

CREATE TABLE performance_summary (
    performance_id     SERIAL PRIMARY KEY,
    branch_id             INTEGER NOT NULL REFERENCES branches(branch_id),
    total_sales             DECIMAL(12,2) NOT NULL DEFAULT 0,
    total_collections         DECIMAL(12,2) NOT NULL DEFAULT 0,
    inventory_accuracy          DECIMAL(5,2) NOT NULL DEFAULT 0,
    generated_at                  TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE notifications (
    notification_id  SERIAL PRIMARY KEY,
    user_id            INTEGER NOT NULL REFERENCES users(user_id),
    title                VARCHAR(100) NOT NULL,
    message                TEXT NOT NULL,
    status                  VARCHAR(10) NOT NULL DEFAULT 'Unread'
                            CHECK (status IN ('Read', 'Unread')),
    created_at                TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE audit_logs (
    log_id           SERIAL PRIMARY KEY,
    user_id            INTEGER NOT NULL REFERENCES users(user_id),
    user_name            VARCHAR(150) NOT NULL,
    action                 VARCHAR(150) NOT NULL,
    ip_address               VARCHAR(45) NOT NULL,
    status_details             VARCHAR(150) NOT NULL,
    created_at                   TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);


-- =====================================================================
-- INDEXES on foreign keys (Postgres does not auto-index FK columns,
-- unlike the PK side; add these for join/lookup performance)
-- =====================================================================

CREATE INDEX idx_role_permissions_permission_id ON role_permissions(permission_id);
CREATE INDEX idx_users_branch_id ON users(branch_id);
CREATE INDEX idx_users_role_id ON users(role_id);
CREATE INDEX idx_territories_branch_id ON territories(branch_id);
CREATE INDEX idx_territories_assigned_user ON territories(assigned_user);
CREATE INDEX idx_products_category_id ON products(category_id);
CREATE INDEX idx_customers_user_id ON customers(user_id);
CREATE INDEX idx_customers_branch_id ON customers(branch_id);
CREATE INDEX idx_customer_credit_info_approved_by ON customer_credit_info(approved_by);
CREATE INDEX idx_branch_inventory_product_id ON branch_inventory(product_id);
CREATE INDEX idx_restock_records_product_id ON restock_records(product_id);
CREATE INDEX idx_restock_records_branch_id ON restock_records(branch_id);
CREATE INDEX idx_restock_records_supplier_id ON restock_records(supplier_id);
CREATE INDEX idx_stock_movements_product_id ON stock_movements(product_id);
CREATE INDEX idx_stock_movements_performed_by ON stock_movements(performed_by);
CREATE INDEX idx_transfers_product_id ON transfers(product_id);
CREATE INDEX idx_transfers_source_branch_id ON transfers(source_branch_id);
CREATE INDEX idx_transfers_destination_branch_id ON transfers(destination_branch_id);
CREATE INDEX idx_sales_invoices_customer_id ON sales_invoices(customer_id);
CREATE INDEX idx_sales_invoices_sales_agent_id ON sales_invoices(sales_agent_id);
CREATE INDEX idx_sales_invoices_branch_id ON sales_invoices(branch_id);
CREATE INDEX idx_sales_invoices_payment_method_id ON sales_invoices(payment_method_id);
CREATE INDEX idx_sales_invoice_items_invoices_id ON sales_invoice_items(invoices_id);
CREATE INDEX idx_sales_invoice_items_product_id ON sales_invoice_items(product_id);
CREATE INDEX idx_collection_payment_customer_id ON collection_payment(customer_id);
CREATE INDEX idx_collection_payment_collector_id ON collection_payment(collector_id);
CREATE INDEX idx_collection_payment_branch_id ON collection_payment(branch_id);
CREATE INDEX idx_collection_payment_payment_method_id ON collection_payment(payment_method_id);
CREATE INDEX idx_digital_receipts_collection_id ON digital_receipts(collection_id);
CREATE INDEX idx_credit_history_customer_id ON credit_history(customer_id);
CREATE INDEX idx_credit_history_sales_id ON credit_history(sales_id);
CREATE INDEX idx_credit_history_collection_id ON credit_history(collection_id);
CREATE INDEX idx_field_visits_customer_id ON field_visits(customer_id);
CREATE INDEX idx_field_visits_user_id ON field_visits(user_id);
CREATE INDEX idx_field_activity_reports_visit_id ON field_activity_reports(visit_id);
CREATE INDEX idx_field_activity_reports_user_id ON field_activity_reports(user_id);
CREATE INDEX idx_field_activity_reports_sync_status ON field_activity_reports(sync_status);
CREATE INDEX idx_offline_sync_queue_user_id ON offline_sync_queue(user_id);
CREATE INDEX idx_offline_sync_queue_sync_status ON offline_sync_queue(sync_status);
CREATE INDEX idx_offline_sync_queue_table_record ON offline_sync_queue(table_name, record_reference);
CREATE INDEX idx_saw_results_customer_id ON saw_results(customer_id);
CREATE INDEX idx_performance_summary_branch_id ON performance_summary(branch_id);
CREATE INDEX idx_notifications_user_id ON notifications(user_id);
CREATE INDEX idx_audit_logs_user_id ON audit_logs(user_id);

COMMIT;